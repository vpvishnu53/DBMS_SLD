PORT=5000
NODE_ENV=development

# Oracle XE 11.2 (local) -- app schema created by database/00_create_user.sql
DB_USER=slms
DB_PASSWORD=slms_dev_2026
DB_CONNECT_STRING=localhost:1521/XE
DB_POOL_MAX=8
# XE 11g needs node-oracledb Thick mode -> point at XE's bundled 64-bit OCI libs
ORACLE_CLIENT_LIB_DIR=C:\oraclexe\app\oracle\product\11.2.0\server\bin

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000

# Email for sign-up verification codes (OTP). Leave SMTP_* empty for DEV mode:
# codes are printed in this terminal and shown on the sign-up page.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#        SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password> (needs 2-step verification)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
