PORT=5000
NODE_ENV=development

# Oracle XE 11.2 (local) -- app schema created by database/00_create_user.sql
DB_USER=slms
DB_PASSWORD=slms_dev_2026
DB_CONNECT_STRING=localhost:1521/XE
DB_POOL_MAX=8
# XE 11g needs node-oracledb Thick mode -> point at XE's bundled 64-bit OCI libs
ORACLE_CLIENT_LIB_DIR=C:\oraclexe\app\oracle\product\11.2.0\server\bin

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000

# ---- Email for sign-up verification codes (OTP) ----
# Codes are only ever EMAILED (never shown on the website).
# Gmail: turn on 2-Step Verification, create an App Password at
#   https://myaccount.google.com/apppasswords  and paste the 16 characters below.
# Check the settings with:  npm run mail:test -- you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Offline demo only: OTP_DEV_MODE=true prints codes in the API terminal when SMTP is empty
OTP_DEV_MODE=false
